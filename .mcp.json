{
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["-y", "@toolbox-sdk/server@latest", "--prebuilt", "mysql", "--stdio"],
      "env": {
        "MYSQL_HOST": "${MYSQL_HOST:-localhost}",
        "MYSQL_PORT": "${MYSQL_PORT:-3306}",
        "MYSQL_DATABASE": "${MYSQL_DATABASE}",
        "MYSQL_USER": "${MYSQL_USER}",
        "MYSQL_PASSWORD": "${MYSQL_PASSWORD}"
      }
    }
  }
}
